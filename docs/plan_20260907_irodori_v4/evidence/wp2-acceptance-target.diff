+func equalInts(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func repeatedASCII(ch byte, n int) string {
+	b := make([]byte, n)
+	for i := range b {
+		b[i] = ch
+	}
+	return string(b)
+}
+
+func repeatedString(s string, n int) string {
+	var b strings.Builder
+	b.Grow(len(s) * n)
+	for i := 0; i < n; i++ {
+		b.WriteString(s)
+	}
+	return b.String()
+}
+
+func itoa(n int) string {
+	return fmt.Sprintf("%d", n)
+}
+
+func minInt(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
